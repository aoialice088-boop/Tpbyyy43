-- TESTE 1: NetworkOwnership
local function testNetworkOwnership()
    addReport("\n[1/16] NetworkOwnership", Color3.fromRGB(255, 170, 0))
    local character = player.Character
    if not character then addReport("❌ Sem character", Color3.fromRGB(255, 100, 100)); return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then addReport("❌ Sem HRP", Color3.fromRGB(255, 100, 100)); return end
    
    local startPos = hrp.Position
    pcall(function() hrp:SetNetworkOwner(nil) end)
    task.wait(0.2)
    
    hrp.CFrame = CFrame.new(startPos + Vector3.new(0, 5, 0))
    task.wait(0.3)
    
    local finalPos = hrp.Position
    local error = (finalPos - (startPos + Vector3.new(0, 5, 0))).Magnitude
    
    pcall(function() hrp:SetNetworkOwner(player) end)
    hrp.CFrame = CFrame.new(startPos)
    task.wait(0.2)
    
    if error < 2 then
        addReport("✅ MANIPULÁVEL", Color3.fromRGB(100, 255, 150))
        addReport("   Erro: " .. string.format("%.2f", error) .. " studs", Color3.fromRGB(150, 200, 255))
        table.insert(workingMethods, "network_spoof")
    else
        addReport("❌ Servidor CORRIGE", Color3.fromRGB(255, 100, 100))
        addReport("   Erro: " .. string.format("%.2f", error) .. " studs", Color3.fromRGB(255, 150, 150))
    end
end

-- TESTE 2: RemoteEvents
local function testRemoteEvents()
    addReport("\n[2/16] RemoteEvents Expostos", Color3.fromRGB(255, 170, 0))
    local teleportRemotes = {}
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local name = string.lower(obj.Name)
            if string.find(name, "tp") or string.find(name, "teleport") or 
               string.find(name, "move") or string.find(name, "position") then
                table.insert(teleportRemotes, obj)
            end
        end
    end
    if #teleportRemotes > 0 then
        addReport("✅ " .. #teleportRemotes .. " encontrado(s):", Color3.fromRGB(100, 255, 150))
        for _, remote in ipairs(teleportRemotes) do
            addReport("   • " .. remote.Name, Color3.fromRGB(150, 200, 255))
        end
        table.insert(workingMethods, "remote_spoof")
    else
        addReport("❌ Nenhum encontrado", Color3.fromRGB(255, 100, 100))
    end
end

-- TESTE 3: Colisão
local function testCollision()
    addReport("\n[3/16] Colisão (CanCollide)", Color3.fromRGB(255, 170, 0))
    local character = player.Character
    if not character then addReport("❌ Sem character", Color3.fromRGB(255, 100, 100)); return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local originalCollisions = {}
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then originalCollisions[part] = part.CanCollide end
    end
    
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
    
    local startPos = hrp.Position
    local testPos = startPos + Vector3.new(0, 10, 0)
    hrp.CFrame = CFrame.new(testPos)
    task.wait(0.3)
    
    local finalPos = hrp.Position
    local error = (finalPos - testPos).Magnitude
    
    for part, original in pairs(originalCollisions) do
        if part and part.Parent then part.CanCollide = original end
    end
    hrp.CFrame = CFrame.new(startPos)
    task.wait(0.2)
    
    if error < 2 then
        addReport("✅ MANIPULÁVEL", Color3.fromRGB(100, 255, 150))
        addReport("   Atravessa paredes", Color3.fromRGB(150, 200, 255))
        table.insert(workingMethods, "phase_walk")
    else
        addReport("❌ Servidor detecta", Color3.fromRGB(255, 100, 100))
        addReport("   Erro: " .. string.format("%.2f", error) .. " studs", Color3.fromRGB(255, 150, 150))
    end
end

