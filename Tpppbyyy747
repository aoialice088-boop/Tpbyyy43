-- TESTE 5: Micro-Steps
local function testMicroSteps()
    addReport("\n[5/16] Micro-Steps", Color3.fromRGB(255, 170, 0))
    local character = player.Character
    if not character then addReport("❌ Sem character", Color3.fromRGB(255, 100, 100)); return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local startPos = hrp.Position
    local targetPos = startPos + Vector3.new(10, 0, 0)
    
    for i = 1, 20 do
        local progress = i / 20
        local currentPos = startPos:Lerp(targetPos, progress)
        hrp.CFrame = CFrame.new(currentPos)
        task.wait(0.02)
    end
    
    local finalPos = hrp.Position
    local error = (finalPos - targetPos).Magnitude
    hrp.CFrame = CFrame.new(startPos)
    task.wait(0.2)
    
    if error < 2 then
        addReport("✅ FUNCIONAM", Color3.fromRGB(100, 255, 150))
        addReport("   Erro: " .. string.format("%.2f", error) .. " studs", Color3.fromRGB(150, 200, 255))
        table.insert(workingMethods, "micro_steps")
    else
        addReport("❌ Servidor detecta", Color3.fromRGB(255, 100, 100))
        addReport("   Erro: " .. string.format("%.2f", error) .. " studs", Color3.fromRGB(255, 150, 150))
    end
end

